# Copy to `.env` and fill in. Never commit the real file.

# Comma-separated list of browser origins allowed to call this API.
# Development default; in production set it to your Vercel domain(s), e.g.
#   FRONTEND_ORIGINS=https://ai-planner.vercel.app,https://ai-planner-git-main-you.vercel.app
# Never use "*" in production — credentials are enabled.
FRONTEND_ORIGINS=http://localhost:3000

# Used by the roadmap generation pipeline
OPENAI_API_KEY=
YOUTUBE_API_KEY=
